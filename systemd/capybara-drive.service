# Manual driving on boot. Install:
#   sudo cp systemd/capybara-drive.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now capybara-drive
# Watch it:   journalctl -u capybara-drive -f
# Stop it:    sudo systemctl stop capybara-drive
# Off again:  sudo systemctl disable --now capybara-drive
#
# Builds are NOT done here: a boot-time colcon build is slow and fails silently
# when something is broken. Build once by hand (scripts/drive.sh), then enable.
[Unit]
Description=Capybara manual driving (joystick teleop)
After=network-online.target bluetooth.target
Wants=bluetooth.target

[Service]
Type=simple
User=jetsonson
WorkingDirectory=/home/jetsonson/capybara-software
ExecStart=/home/jetsonson/capybara-software/scripts/drive.sh --no-build
Restart=on-failure
RestartSec=5
# ros2 launch traps SIGINT and shuts the controllers down cleanly
KillSignal=SIGINT
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
